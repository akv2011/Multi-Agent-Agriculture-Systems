# AgriMitr Frontend Environment Configuration
# Copy this file to .env and fill in your actual values

# Security Notes:
# 1. Never commit real credentials to git
# 2. Use environment variables or secret management in production
# 3. Rotate API keys regularly
# 4. Use base64 encoding for demo credentials to avoid plain text passwords
# 5. Always use .env files that are listed in .gitignore

# Demo Mode Configuration
VITE_DEMO_MODE=true

# Demo Credentials (Base64 encoded username:password)
# Generate these using: echo -n "username:password" | base64
# SECURITY: Never commit real credentials to git
VITE_DEMO_ADMIN_HASH=your_base64_encoded_admin_credentials_here
VITE_DEMO_USER_HASH=your_base64_encoded_user_credentials_here
VITE_DEMO_FARMER_HASH=your_base64_encoded_farmer_credentials_here
VITE_DEMO_AgriMitr_HASH=your_base64_encoded_AgriMitr_credentials_here

# API Configuration
VITE_API_BASE_URL=http://localhost:8001/api/v1
REACT_APP_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# WebSocket Configuration  
VITE_WEBSOCKET_URL=ws://localhost:8001/ws
REACT_APP_WEBSOCKET_URL=ws://localhost:8765

# Mock Data Settings (for development)
VITE_MOCK_GROUND_SEARCH=true
VITE_ENABLE_WEBSOCKET_MOCK=true
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_CHATBOT=true

# Analytics (optional)
REACT_APP_ANALYTICS_KEY=your_analytics_key_here

# Google Gemini AI API Key for Agricultural Query Analysis
# Get your API key from: https://makersuite.google.com/app/apikey
# SECURITY: Never commit real API keys to version control
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Demo Authentication Settings (for development only)
VITE_DEMO_MODE=false

# Demo User Credentials (Base64 encoded username:password pairs)
# Replace with your own secure credentials for demo mode
# To generate: echo -n "username:password" | base64
# VITE_DEMO_ADMIN_HASH=your_base64_encoded_admin_credentials
# VITE_DEMO_USER_HASH=your_base64_encoded_user_credentials  
# VITE_DEMO_FARMER_HASH=your_base64_encoded_farmer_credentials
# VITE_DEMO_AGRISENS_HASH=your_base64_encoded_agrisens_credentials

# Demo Default User (for quick login button)
VITE_DEMO_DEFAULT_USER=demo

# Feature Flags
REACT_APP_ENABLE_SATELLITE_VISUALIZATION=true
REACT_APP_ENABLE_MULTILINGUAL_SUPPORT=true

# Analytics (optional)
REACT_APP_ANALYTICS_KEY=your_analytics_key_here

# Google Gemini AI API Key for Agricultural Query Analysis
# Get your API key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# API URLs for different services
VITE_API_BASE_URL=http://localhost:8000
VITE_AGENTWEAVER_API_URL=http://localhost:8001
