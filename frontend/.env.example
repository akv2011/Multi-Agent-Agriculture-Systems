# Multi-Agent Agriculture Systems Frontend Environment Configuration
# Copy this file to .env.development or .env.production based on your environment

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8000

# WebSocket Configuration
REACT_APP_WEBSOCKET_URL=ws://localhost:8765

# Feature Flags
REACT_APP_ENABLE_SATELLITE_VISUALIZATION=true
REACT_APP_ENABLE_MULTILINGUAL_SUPPORT=true

# Analytics (optional)
REACT_APP_ANALYTICS_KEY=your_analytics_key_here

# Google Gemini AI API Key for Agricultural Query Analysis
# Get your API key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Environment Variables
# Demo Authentication Settings (for development only)
VITE_DEMO_MODE=true
VITE_API_BASE_URL=http://localhost:8000

# Demo User Credentials (Base64 encoded for basic obfuscation in demo)
# These should be replaced with proper authentication in production
VITE_DEMO_ADMIN_HASH=YWRtaW46YWRtaW4xMjM=
VITE_DEMO_USER_HASH=dXNlcjp1c2VyMTIz
VITE_DEMO_FARMER_HASH=ZmFybWVyOmZhcm1lcjEyMw==
VITE_DEMO_AGRISENS_HASH=YWdyaXNlbnM6YWdyaXNlbnMyMDI1
