<svg width="300" height="200" viewBox="0 0 300 200" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="skyGradient4" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#2563eb;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#93c5fd;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="cottonFieldGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#84cc16;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#65a30d;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Sky -->
  <rect width="300" height="100" fill="url(#skyGradient4)"/>
  
  <!-- Field -->
  <rect y="100" width="300" height="100" fill="url(#cottonFieldGradient)"/>
  
  <!-- Cotton plants -->
  <g>
    <!-- Plant stems -->
    <line x1="40" y1="200" x2="40" y2="130" stroke="#16a34a" stroke-width="3"/>
    <line x1="80" y1="200" x2="80" y2="135" stroke="#16a34a" stroke-width="3"/>
    <line x1="120" y1="200" x2="120" y2="132" stroke="#16a34a" stroke-width="3"/>
    <line x1="160" y1="200" x2="160" y2="138" stroke="#16a34a" stroke-width="3"/>
    <line x1="200" y1="200" x2="200" y2="134" stroke="#16a34a" stroke-width="3"/>
    <line x1="240" y1="200" x2="240" y2="136" stroke="#16a34a" stroke-width="3"/>
    
    <!-- Branches -->
    <line x1="40" y1="150" x2="50" y2="140" stroke="#22c55e" stroke-width="2"/>
    <line x1="40" y1="160" x2="30" y2="150" stroke="#22c55e" stroke-width="2"/>
    <line x1="80" y1="155" x2="90" y2="145" stroke="#22c55e" stroke-width="2"/>
    <line x1="80" y1="165" x2="70" y2="155" stroke="#22c55e" stroke-width="2"/>
    <line x1="120" y1="152" x2="130" y2="142" stroke="#22c55e" stroke-width="2"/>
    <line x1="120" y1="162" x2="110" y2="152" stroke="#22c55e" stroke-width="2"/>
    <line x1="160" y1="158" x2="170" y2="148" stroke="#22c55e" stroke-width="2"/>
    <line x1="160" y1="168" x2="150" y2="158" stroke="#22c55e" stroke-width="2"/>
    <line x1="200" y1="154" x2="210" y2="144" stroke="#22c55e" stroke-width="2"/>
    <line x1="200" y1="164" x2="190" y2="154" stroke="#22c55e" stroke-width="2"/>
    <line x1="240" y1="156" x2="250" y2="146" stroke="#22c55e" stroke-width="2"/>
    <line x1="240" y1="166" x2="230" y2="156" stroke="#22c55e" stroke-width="2"/>
    
    <!-- Cotton bolls -->
    <circle cx="48" cy="135" r="6" fill="#ffffff" stroke="#e5e7eb" stroke-width="1"/>
    <circle cx="32" cy="145" r="5" fill="#ffffff" stroke="#e5e7eb" stroke-width="1"/>
    <circle cx="88" cy="140" r="6" fill="#ffffff" stroke="#e5e7eb" stroke-width="1"/>
    <circle cx="72" cy="150" r="5" fill="#ffffff" stroke="#e5e7eb" stroke-width="1"/>
    <circle cx="128" cy="137" r="6" fill="#ffffff" stroke="#e5e7eb" stroke-width="1"/>
    <circle cx="112" cy="147" r="5" fill="#ffffff" stroke="#e5e7eb" stroke-width="1"/>
    <circle cx="168" cy="143" r="6" fill="#ffffff" stroke="#e5e7eb" stroke-width="1"/>
    <circle cx="152" cy="153" r="5" fill="#ffffff" stroke="#e5e7eb" stroke-width="1"/>
    <circle cx="208" cy="139" r="6" fill="#ffffff" stroke="#e5e7eb" stroke-width="1"/>
    <circle cx="192" cy="149" r="5" fill="#ffffff" stroke="#e5e7eb" stroke-width="1"/>
    <circle cx="248" cy="141" r="6" fill="#ffffff" stroke="#e5e7eb" stroke-width="1"/>
    <circle cx="232" cy="151" r="5" fill="#ffffff" stroke="#e5e7eb" stroke-width="1"/>
    
    <!-- Cotton boll details -->
    <circle cx="46" cy="133" r="2" fill="#f9fafb" opacity="0.8"/>
    <circle cx="50" cy="137" r="2" fill="#f9fafb" opacity="0.8"/>
    <circle cx="86" cy="138" r="2" fill="#f9fafb" opacity="0.8"/>
    <circle cx="90" cy="142" r="2" fill="#f9fafb" opacity="0.8"/>
    <circle cx="126" cy="135" r="2" fill="#f9fafb" opacity="0.8"/>
    <circle cx="130" cy="139" r="2" fill="#f9fafb" opacity="0.8"/>
    <circle cx="166" cy="141" r="2" fill="#f9fafb" opacity="0.8"/>
    <circle cx="170" cy="145" r="2" fill="#f9fafb" opacity="0.8"/>
    <circle cx="206" cy="137" r="2" fill="#f9fafb" opacity="0.8"/>
    <circle cx="210" cy="141" r="2" fill="#f9fafb" opacity="0.8"/>
    <circle cx="246" cy="139" r="2" fill="#f9fafb" opacity="0.8"/>
    <circle cx="250" cy="143" r="2" fill="#f9fafb" opacity="0.8"/>
  </g>
  
  <!-- Leaves -->
  <g>
    <ellipse cx="45" cy="160" rx="4" ry="8" fill="#22c55e" transform="rotate(-20 45 160)"/>
    <ellipse cx="35" cy="165" rx="4" ry="8" fill="#16a34a" transform="rotate(15 35 165)"/>
    <ellipse cx="85" cy="165" rx="4" ry="8" fill="#22c55e" transform="rotate(-25 85 165)"/>
    <ellipse cx="75" cy="170" rx="4" ry="8" fill="#16a34a" transform="rotate(20 75 170)"/>
    <ellipse cx="125" cy="162" rx="4" ry="8" fill="#22c55e" transform="rotate(-20 125 162)"/>
    <ellipse cx="115" cy="167" rx="4" ry="8" fill="#16a34a" transform="rotate(15 115 167)"/>
    <ellipse cx="165" cy="168" rx="4" ry="8" fill="#22c55e" transform="rotate(-25 165 168)"/>
    <ellipse cx="155" cy="173" rx="4" ry="8" fill="#16a34a" transform="rotate(20 155 173)"/>
    <ellipse cx="205" cy="164" rx="4" ry="8" fill="#22c55e" transform="rotate(-20 205 164)"/>
    <ellipse cx="195" cy="169" rx="4" ry="8" fill="#16a34a" transform="rotate(15 195 169)"/>
    <ellipse cx="245" cy="166" rx="4" ry="8" fill="#22c55e" transform="rotate(-25 245 166)"/>
    <ellipse cx="235" cy="171" rx="4" ry="8" fill="#16a34a" transform="rotate(20 235 171)"/>
  </g>
  
  <!-- Ground rows -->
  <path d="M0 180 L300 180" stroke="#4d7c0f" stroke-width="1" opacity="0.5"/>
  <path d="M0 190 L300 190" stroke="#4d7c0f" stroke-width="1" opacity="0.5"/>
  
  <!-- Clouds -->
  <ellipse cx="70" cy="30" rx="18" ry="10" fill="white" opacity="0.9"/>
  <ellipse cx="230" cy="40" rx="22" ry="13" fill="white" opacity="0.9"/>
  
  <text x="150" y="195" font-family="Arial, sans-serif" font-size="14" fill="#ffffff" text-anchor="middle">Cotton Field</text>
</svg>
