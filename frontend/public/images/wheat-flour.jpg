<svg width="300" height="200" viewBox="0 0 300 200" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="wheatGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#fef7cd;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#eab308;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="300" height="200" fill="url(#wheatGradient)"/>
  <g transform="translate(30, 30)">
    <!-- Wheat flour texture -->
    <circle cx="50" cy="30" r="2" fill="#facc15" opacity="0.7"/>
    <circle cx="70" cy="25" r="1.5" fill="#eab308" opacity="0.8"/>
    <circle cx="90" cy="35" r="2" fill="#facc15" opacity="0.6"/>
    <circle cx="110" cy="28" r="1.5" fill="#eab308" opacity="0.9"/>
    <circle cx="130" cy="32" r="2" fill="#facc15" opacity="0.7"/>
    <circle cx="150" cy="26" r="1.5" fill="#eab308" opacity="0.8"/>
    <circle cx="170" cy="30" r="2" fill="#facc15" opacity="0.6"/>
    <circle cx="190" cy="33" r="1.5" fill="#eab308" opacity="0.9"/>
    <circle cx="210" cy="29" r="2" fill="#facc15" opacity="0.7"/>
    <circle cx="230" cy="31" r="1.5" fill="#eab308" opacity="0.8"/>
    
    <!-- More flour particles -->
    <circle cx="45" cy="50" r="1.5" fill="#eab308" opacity="0.6"/>
    <circle cx="65" cy="55" r="2" fill="#facc15" opacity="0.8"/>
    <circle cx="85" cy="52" r="1.5" fill="#eab308" opacity="0.7"/>
    <circle cx="105" cy="58" r="2" fill="#facc15" opacity="0.6"/>
    <circle cx="125" cy="54" r="1.5" fill="#eab308" opacity="0.9"/>
    <circle cx="145" cy="51" r="2" fill="#facc15" opacity="0.7"/>
    <circle cx="165" cy="56" r="1.5" fill="#eab308" opacity="0.8"/>
    <circle cx="185" cy="53" r="2" fill="#facc15" opacity="0.6"/>
    <circle cx="205" cy="57" r="1.5" fill="#eab308" opacity="0.9"/>
    <circle cx="225" cy="55" r="2" fill="#facc15" opacity="0.7"/>
    
    <!-- Bottom layer -->
    <circle cx="40" cy="75" r="2" fill="#facc15" opacity="0.5"/>
    <circle cx="60" cy="78" r="1.5" fill="#eab308" opacity="0.6"/>
    <circle cx="80" cy="72" r="2" fill="#facc15" opacity="0.7"/>
    <circle cx="100" cy="76" r="1.5" fill="#eab308" opacity="0.5"/>
    <circle cx="120" cy="74" r="2" fill="#facc15" opacity="0.6"/>
    <circle cx="140" cy="77" r="1.5" fill="#eab308" opacity="0.7"/>
    <circle cx="160" cy="73" r="2" fill="#facc15" opacity="0.5"/>
    <circle cx="180" cy="79" r="1.5" fill="#eab308" opacity="0.6"/>
    <circle cx="200" cy="75" r="2" fill="#facc15" opacity="0.7"/>
    <circle cx="220" cy="78" r="1.5" fill="#eab308" opacity="0.5"/>
    
    <!-- Organic label -->
    <rect x="10" y="10" width="60" height="20" rx="10" fill="#22c55e" opacity="0.9"/>
    <text x="40" y="23" font-family="Arial, sans-serif" font-size="10" fill="white" text-anchor="middle" font-weight="bold">ORGANIC</text>
  </g>
  <text x="150" y="180" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#a16207" text-anchor="middle">Organic Wheat Flour</text>
</svg>
