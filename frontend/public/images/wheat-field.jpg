<svg width="300" height="200" viewBox="0 0 300 200" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="skyGradient2" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#60a5fa;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#bfdbfe;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="wheatFieldGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#fde047;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#eab308;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Sky -->
  <rect width="300" height="100" fill="url(#skyGradient2)"/>
  
  <!-- Wheat field -->
  <rect y="100" width="300" height="100" fill="url(#wheatFieldGradient)"/>
  
  <!-- Wheat stalks -->
  <g>
    <line x1="20" y1="100" x2="20" y2="80" stroke="#ca8a04" stroke-width="2"/>
    <line x1="40" y1="100" x2="40" y2="85" stroke="#ca8a04" stroke-width="2"/>
    <line x1="60" y1="100" x2="60" y2="82" stroke="#ca8a04" stroke-width="2"/>
    <line x1="80" y1="100" x2="80" y2="87" stroke="#ca8a04" stroke-width="2"/>
    <line x1="100" y1="100" x2="100" y2="83" stroke="#ca8a04" stroke-width="2"/>
    <line x1="120" y1="100" x2="120" y2="86" stroke="#ca8a04" stroke-width="2"/>
    <line x1="140" y1="100" x2="140" y2="81" stroke="#ca8a04" stroke-width="2"/>
    <line x1="160" y1="100" x2="160" y2="88" stroke="#ca8a04" stroke-width="2"/>
    <line x1="180" y1="100" x2="180" y2="84" stroke="#ca8a04" stroke-width="2"/>
    <line x1="200" y1="100" x2="200" y2="87" stroke="#ca8a04" stroke-width="2"/>
    <line x1="220" y1="100" x2="220" y2="82" stroke="#ca8a04" stroke-width="2"/>
    <line x1="240" y1="100" x2="240" y2="85" stroke="#ca8a04" stroke-width="2"/>
    <line x1="260" y1="100" x2="260" y2="83" stroke="#ca8a04" stroke-width="2"/>
    <line x1="280" y1="100" x2="280" y2="86" stroke="#ca8a04" stroke-width="2"/>
  </g>
  
  <!-- Wheat ears -->
  <g>
    <ellipse cx="20" cy="75" rx="3" ry="8" fill="#fef08a"/>
    <ellipse cx="40" cy="80" rx="3" ry="8" fill="#fde047"/>
    <ellipse cx="60" cy="77" rx="3" ry="8" fill="#fef08a"/>
    <ellipse cx="80" cy="82" rx="3" ry="8" fill="#fde047"/>
    <ellipse cx="100" cy="78" rx="3" ry="8" fill="#fef08a"/>
    <ellipse cx="120" cy="81" rx="3" ry="8" fill="#fde047"/>
    <ellipse cx="140" cy="76" rx="3" ry="8" fill="#fef08a"/>
    <ellipse cx="160" cy="83" rx="3" ry="8" fill="#fde047"/>
    <ellipse cx="180" cy="79" rx="3" ry="8" fill="#fef08a"/>
    <ellipse cx="200" cy="82" rx="3" ry="8" fill="#fde047"/>
    <ellipse cx="220" cy="77" rx="3" ry="8" fill="#fef08a"/>
    <ellipse cx="240" cy="80" rx="3" ry="8" fill="#fde047"/>
    <ellipse cx="260" cy="78" rx="3" ry="8" fill="#fef08a"/>
    <ellipse cx="280" cy="81" rx="3" ry="8" fill="#fde047"/>
  </g>
  
  <!-- Ground details -->
  <g>
    <path d="M0 180 Q50 185, 100 180 Q150 175, 200 180 Q250 185, 300 180" stroke="#a16207" stroke-width="2" fill="none"/>
    <path d="M0 190 Q75 195, 150 190 Q225 185, 300 190" stroke="#a16207" stroke-width="1" fill="none" opacity="0.5"/>
  </g>
  
  <!-- Clouds -->
  <ellipse cx="70" cy="30" rx="20" ry="12" fill="white" opacity="0.9"/>
  <ellipse cx="230" cy="40" rx="25" ry="15" fill="white" opacity="0.9"/>
  
  <text x="150" y="195" font-family="Arial, sans-serif" font-size="14" fill="#92400e" text-anchor="middle">Wheat Field</text>
</svg>
