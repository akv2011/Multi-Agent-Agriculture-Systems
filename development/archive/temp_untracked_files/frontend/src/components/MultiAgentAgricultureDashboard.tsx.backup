import { useState } from 'react';
import { 
  Activity, AlertTriangle, CheckCircle, Clock, Database, TrendingUp, 
  Droplets, Sun, Bug, DollarSign, BarChart3, Settings, 
  Search, Filter, RefreshCw, Menu, X, Home, Users, Cpu, 
  Monitor, FileText, Wrench
} from 'lucide-react';

interface Agent {
  id: string;
  name: string;
  category: string;
  status: 'active' | 'idle' | 'error' | 'offline';
  lastUpdate: string;
  performance: number;
  uptime: number;
  responseTime: number;
  tasksCompleted: number;
  description: string;
}

interface AgentCategory {
  name: string;
  color: string;
  icon: React.ReactNode;
  agents: Agent[];
}

type NavigationItem = 'overview' | 'agents' | 'workflows' | 'monitoring' | 'documentation' | 'settings';

const MultiAgentAgricultureDashboard = () => {
  const [selectedAgent, setSelectedAgent] = useState<Agent | null>(null);
  const [searchTerm, setSearchTerm] = useState<string>('');
  const [filterStatus, setFilterStatus] = useState<string>('all');
  const [refreshing, setRefreshing] = useState<boolean>(false);
  const [lastUpdated, setLastUpdated] = useState<Date>(new Date());
  const [sidebarOpen, setSidebarOpen] = useState<boolean>(true);
  const [activeNavItem, setActiveNavItem] = useState<NavigationItem>('overview');

  // Core agricultural agents based on your system
  const agriculturalAgents: Agent[] = [
    {
      id: 'router-001',
      name: 'Router Agent',
      category: 'Query Processing',
      status: 'active',
      lastUpdate: new Date(Date.now() - Math.random() * 300000).toLocaleTimeString(),
      performance: 98,
      uptime: 99.8,
      responseTime: 45,
      tasksCompleted: 1247,
      description: 'Intelligent query classification and routing system'
    },
    {
      id: 'crop-001',
      name: 'Crop Selection Agent',
      category: 'Crop Management',
      status: 'active',
      lastUpdate: new Date(Date.now() - Math.random() * 300000).toLocaleTimeString(),
      performance: 95,
      uptime: 99.2,
      responseTime: 67,
      tasksCompleted: 892,
      description: 'Crop recommendations and yield predictions'
    },
    {
      id: 'pest-001',
      name: 'Pest Forecaster Agent',
      category: 'Pest & Disease',
      status: 'active',
      lastUpdate: new Date(Date.now() - Math.random() * 300000).toLocaleTimeString(),
      performance: 93,
      uptime: 98.5,
      responseTime: 89,
      tasksCompleted: 654,
      description: 'Pest detection and treatment recommendations'
    },
    {
      id: 'irrigation-001',
      name: 'Irrigation Agent',
      category: 'Water Management',
      status: 'idle',
      lastUpdate: new Date(Date.now() - Math.random() * 300000).toLocaleTimeString(),
      performance: 91,
      uptime: 97.8,
      responseTime: 112,
      tasksCompleted: 567,
      description: 'Water scheduling and optimization'
    },
    {
      id: 'market-001',
      name: 'Market Timing Agent',
      category: 'Market Intelligence',
      status: 'active',
      lastUpdate: new Date(Date.now() - Math.random() * 300000).toLocaleTimeString(),
      performance: 88,
      uptime: 96.4,
      responseTime: 134,
      tasksCompleted: 432,
      description: 'Price forecasting and market analysis'
    },
    {
      id: 'finance-001',
      name: 'Finance & Policy Agent',
      category: 'Financial Services',
      status: 'active',
      lastUpdate: new Date(Date.now() - Math.random() * 300000).toLocaleTimeString(),
      performance: 94,
      uptime: 98.9,
      responseTime: 78,
      tasksCompleted: 321,
      description: 'Loan eligibility and subsidy information'
    },
    {
      id: 'data-001',
      name: 'Data Layer Agent',
      category: 'Data Processing',
      status: 'active',
      lastUpdate: new Date(Date.now() - Math.random() * 300000).toLocaleTimeString(),
      performance: 97,
      uptime: 99.5,
      responseTime: 56,
      tasksCompleted: 1089,
      description: 'Satellite imagery and sensor data processing'
    }
  ];

  // Navigation items
  const navigationItems = [
    { id: 'overview' as NavigationItem, name: 'System Overview', icon: <Home className="w-5 h-5" /> },
    { id: 'agents' as NavigationItem, name: 'Agent Management', icon: <Users className="w-5 h-5" /> },
    { id: 'workflows' as NavigationItem, name: 'Workflow Engine', icon: <Cpu className="w-5 h-5" /> },
    { id: 'monitoring' as NavigationItem, name: 'Real-time Monitor', icon: <Monitor className="w-5 h-5" /> },
    { id: 'documentation' as NavigationItem, name: 'Documentation', icon: <FileText className="w-5 h-5" /> },
    { id: 'settings' as NavigationItem, name: 'System Settings', icon: <Wrench className="w-5 h-5" /> }
  ];

  // Group agents by category
  const agentCategories: AgentCategory[] = [
    {
      name: 'Query Processing',
      color: 'bg-blue-500',
      icon: <Search className="w-5 h-5" />,
      agents: agriculturalAgents.filter(agent => agent.category === 'Query Processing')
    },
    {
      name: 'Crop Management',
      color: 'bg-green-500',
      icon: <Sun className="w-5 h-5" />,
      agents: agriculturalAgents.filter(agent => agent.category === 'Crop Management')
    },
    {
      name: 'Pest & Disease',
      color: 'bg-red-500',
      icon: <Bug className="w-5 h-5" />,
      agents: agriculturalAgents.filter(agent => agent.category === 'Pest & Disease')
    },
    {
      name: 'Water Management',
      color: 'bg-cyan-500',
      icon: <Droplets className="w-5 h-5" />,
      agents: agriculturalAgents.filter(agent => agent.category === 'Water Management')
    },
    {
      name: 'Market Intelligence',
      color: 'bg-purple-500',
      icon: <DollarSign className="w-5 h-5" />,
      agents: agriculturalAgents.filter(agent => agent.category === 'Market Intelligence')
    },
    {
      name: 'Financial Services',
      color: 'bg-yellow-500',
      icon: <BarChart3 className="w-5 h-5" />,
      agents: agriculturalAgents.filter(agent => agent.category === 'Financial Services')
    },
    {
      name: 'Data Processing',
      color: 'bg-indigo-500',
      icon: <Database className="w-5 h-5" />,
      agents: agriculturalAgents.filter(agent => agent.category === 'Data Processing')
    }
  ];

  const filteredAgents = agriculturalAgents.filter(agent => {
    const matchesSearch = agent.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
                         agent.description.toLowerCase().includes(searchTerm.toLowerCase());
    const matchesFilter = filterStatus === 'all' || agent.status === filterStatus;
    return matchesSearch && matchesFilter;
  });

  const getStatusColor = (status: Agent['status']): string => {
    switch (status) {
      case 'active': return 'text-green-600';
      case 'idle': return 'text-yellow-600';
      case 'error': return 'text-red-600';
      case 'offline': return 'text-gray-600';
      default: return 'text-gray-600';
    }
  };

  const getStatusIcon = (status: Agent['status']): React.ReactNode => {
    switch (status) {
      case 'active': return <CheckCircle className="w-4 h-4" />;
      case 'idle': return <Clock className="w-4 h-4" />;
      case 'error': return <AlertTriangle className="w-4 h-4" />;
      case 'offline': return <Activity className="w-4 h-4" />;
      default: return <Activity className="w-4 h-4" />;
    }
  };

  const getStatusBadgeColor = (status: Agent['status']): string => {
    switch (status) {
      case 'active': return 'bg-green-100 text-green-800';
      case 'idle': return 'bg-yellow-100 text-yellow-800';
      case 'error': return 'bg-red-100 text-red-800';
      case 'offline': return 'bg-gray-100 text-gray-800';
      default: return 'bg-gray-100 text-gray-800';
    }
  };

  const handleRefresh = (): void => {
    setRefreshing(true);
    setLastUpdated(new Date());
    // Simulate API call
    setTimeout(() => {
      setRefreshing(false);
    }, 1500);
  };

  const systemStats = {
    totalAgents: agriculturalAgents.length,
    activeAgents: agriculturalAgents.filter(a => a.status === 'active').length,
    idleAgents: agriculturalAgents.filter(a => a.status === 'idle').length,
    errorAgents: agriculturalAgents.filter(a => a.status === 'error').length,
    avgPerformance: Math.round(agriculturalAgents.reduce((sum, a) => sum + a.performance, 0) / agriculturalAgents.length),
    totalTasksCompleted: agriculturalAgents.reduce((sum, a) => sum + a.tasksCompleted, 0)
  };

  const renderSystemOverview = () => (
    <div>
      {/* Welcome Section */}
      <div className="bg-gradient-to-r from-green-600 to-blue-600 text-white rounded-lg p-8 mb-8">
        <h2 className="text-3xl font-bold mb-4">Welcome to AgentWeaver</h2>
        <p className="text-xl mb-4">Professional Multi-Agent Agriculture System</p>
        <p className="text-green-100 mb-6">
          Intelligent agricultural decision-making powered by specialized AI agents working in harmony.
          Monitor crop management, pest control, irrigation optimization, market analysis, and financial planning.
        </p>
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
          <div>
            <div className="text-2xl font-bold">{systemStats.totalAgents}</div>
            <div className="text-green-100">Active Agents</div>
          </div>
          <div>
            <div className="text-2xl font-bold">{systemStats.totalTasksCompleted.toLocaleString()}</div>
            <div className="text-green-100">Tasks Completed</div>
          </div>
          <div>
            <div className="text-2xl font-bold">{systemStats.avgPerformance}%</div>
            <div className="text-green-100">Avg Performance</div>
          </div>
          <div>
            <div className="text-2xl font-bold">24/7</div>
            <div className="text-green-100">System Uptime</div>
          </div>
        </div>
      </div>

      {/* Key Features */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <div className="bg-white rounded-lg shadow-sm border p-6">
          <div className="flex items-center gap-3 mb-4">
            <Cpu className="w-8 h-8 text-blue-600" />
            <h3 className="text-xl font-semibold">Multi-Agent Orchestration</h3>
          </div>
          <p className="text-gray-600 mb-4">
            Coordinate multiple specialized agricultural agents for comprehensive farm management and decision support.
          </p>
          <div className="space-y-2">
            <div className="flex items-center gap-2 text-sm text-gray-600">
              <CheckCircle className="w-4 h-4 text-green-500" />
              <span>Intelligent task routing and distribution</span>
            </div>
            <div className="flex items-center gap-2 text-sm text-gray-600">
              <CheckCircle className="w-4 h-4 text-green-500" />
              <span>Real-time agent coordination</span>
            </div>
            <div className="flex items-center gap-2 text-sm text-gray-600">
              <CheckCircle className="w-4 h-4 text-green-500" />
              <span>Workflow visualization and monitoring</span>
            </div>
          </div>
        </div>

        <div className="bg-white rounded-lg shadow-sm border p-6">
          <div className="flex items-center gap-3 mb-4">
            <Sun className="w-8 h-8 text-green-600" />
            <h3 className="text-xl font-semibold">Agricultural Intelligence</h3>
          </div>
          <p className="text-gray-600 mb-4">
            Specialized agents for crop management, pest control, irrigation, market analysis, and financial planning.
          </p>
          <div className="space-y-2">
            <div className="flex items-center gap-2 text-sm text-gray-600">
              <CheckCircle className="w-4 h-4 text-green-500" />
              <span>Satellite imagery and sensor integration</span>
            </div>
            <div className="flex items-center gap-2 text-sm text-gray-600">
              <CheckCircle className="w-4 h-4 text-green-500" />
              <span>Predictive analytics for farming decisions</span>
            </div>
            <div className="flex items-center gap-2 text-sm text-gray-600">
              <CheckCircle className="w-4 h-4 text-green-500" />
              <span>Multi-language support (English/Hindi)</span>
            </div>
          </div>
        </div>
      </div>

      {/* System Status Grid */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div className="bg-white p-6 rounded-lg shadow-sm border">
          <div className="flex items-center">
            <div className="flex-shrink-0">
              <Settings className="w-8 h-8 text-blue-600" />
            </div>
            <div className="ml-4">
              <p className="text-sm font-medium text-gray-600">Total Agents</p>
              <p className="text-2xl font-bold text-gray-900">{systemStats.totalAgents}</p>
            </div>
          </div>
        </div>

        <div className="bg-white p-6 rounded-lg shadow-sm border">
          <div className="flex items-center">
            <div className="flex-shrink-0">
              <CheckCircle className="w-8 h-8 text-green-600" />
            </div>
            <div className="ml-4">
              <p className="text-sm font-medium text-gray-600">Active Agents</p>
              <p className="text-2xl font-bold text-green-600">{systemStats.activeAgents}</p>
            </div>
          </div>
        </div>

        <div className="bg-white p-6 rounded-lg shadow-sm border">
          <div className="flex items-center">
            <div className="flex-shrink-0">
              <TrendingUp className="w-8 h-8 text-blue-600" />
            </div>
            <div className="ml-4">
              <p className="text-sm font-medium text-gray-600">Avg Performance</p>
              <p className="text-2xl font-bold text-blue-600">{systemStats.avgPerformance}%</p>
            </div>
          </div>
        </div>

        <div className="bg-white p-6 rounded-lg shadow-sm border">
          <div className="flex items-center">
            <div className="flex-shrink-0">
              <Activity className="w-8 h-8 text-purple-600" />
            </div>
            <div className="ml-4">
              <p className="text-sm font-medium text-gray-600">Tasks Completed</p>
              <p className="text-2xl font-bold text-purple-600">{systemStats.totalTasksCompleted.toLocaleString()}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  );

  const renderAgentManagement = () => (
    <div>
      {/* Search and Filter */}
      <div className="bg-white rounded-lg shadow-sm border p-6 mb-6">
        <div className="flex flex-col md:flex-row gap-4">
          <div className="flex-1">
            <div className="relative">
              <Search className="w-5 h-5 absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400" />
              <input
                type="text"
                placeholder="Search agents..."
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
                className="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>
          </div>
          <div className="flex items-center gap-2">
            <Filter className="w-5 h-5 text-gray-400" />
            <select
              value={filterStatus}
              onChange={(e) => setFilterStatus(e.target.value)}
              className="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            >
              <option value="all">All Status</option>
              <option value="active">Active</option>
              <option value="idle">Idle</option>
              <option value="error">Error</option>
              <option value="offline">Offline</option>
            </select>
          </div>
        </div>
      </div>

      {/* Agent Categories Grid */}
      <div className="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6 mb-8">
        {agentCategories.map((category) => (
          <div key={category.name} className="bg-white rounded-lg shadow-sm border overflow-hidden">
            <div className={`${category.color} text-white p-4`}>
              <div className="flex items-center gap-3">
                {category.icon}
                <h3 className="text-lg font-semibold">{category.name}</h3>
                <span className="ml-auto bg-white bg-opacity-20 px-2 py-1 rounded text-sm">
                  {category.agents.length}
                </span>
              </div>
            </div>
            <div className="p-4">
              {category.agents.map((agent) => (
                <div
                  key={agent.id}
                  className={`flex items-center justify-between p-3 rounded-lg hover:bg-gray-50 cursor-pointer mb-2 transition-colors ${
                    selectedAgent?.id === agent.id ? 'bg-blue-50 border border-blue-200' : 'border border-transparent'
                  }`}
                  onClick={() => setSelectedAgent(agent)}
                >
                  <div className="flex items-center gap-3 flex-1 min-w-0">
                    <div className={getStatusColor(agent.status)}>
                      {getStatusIcon(agent.status)}
                    </div>
                    <div className="min-w-0 flex-1">
                      <p className="text-sm font-medium text-gray-900 truncate">{agent.name}</p>
                      <p className="text-xs text-gray-500">{agent.performance}% performance</p>
                    </div>
                  </div>
                  <span className={`px-2 py-1 rounded-full text-xs font-medium ${getStatusBadgeColor(agent.status)}`}>
                    {agent.status}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      {/* Selected Agent Details */}
      {selectedAgent && (
        <div className="bg-white rounded-lg shadow-sm border">
          <div className="px-6 py-4 border-b border-gray-200">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-3">
                <div className={getStatusColor(selectedAgent.status)}>
                  {getStatusIcon(selectedAgent.status)}
                </div>
                <div>
                  <h2 className="text-xl font-semibold text-gray-900">{selectedAgent.name}</h2>
                  <p className="text-sm text-gray-600">{selectedAgent.description}</p>
                </div>
              </div>
              <button
                onClick={() => setSelectedAgent(null)}
                className="text-gray-400 hover:text-gray-600 text-xl"
              >
                ×
              </button>
            </div>
          </div>
          <div className="p-6">
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
              <div>
                <p className="text-sm font-medium text-gray-600">Status</p>
                <div className="flex items-center gap-2 mt-1">
                  <span className={`px-2 py-1 rounded-full text-xs font-medium ${getStatusBadgeColor(selectedAgent.status)}`}>
                    {selectedAgent.status.charAt(0).toUpperCase() + selectedAgent.status.slice(1)}
                  </span>
                </div>
              </div>
              <div>
                <p className="text-sm font-medium text-gray-600">Performance</p>
                <div className="flex items-center gap-2 mt-1">
                  <div className="flex-1 bg-gray-200 rounded-full h-2">
                    <div
                      className="bg-blue-500 h-2 rounded-full"
                      style={{ width: `${selectedAgent.performance}%` }}
                    ></div>
                  </div>
                  <span className="text-sm font-medium">{selectedAgent.performance}%</span>
                </div>
              </div>
              <div>
                <p className="text-sm font-medium text-gray-600">Uptime</p>
                <p className="text-lg font-semibold text-gray-900 mt-1">{selectedAgent.uptime}%</p>
              </div>
              <div>
                <p className="text-sm font-medium text-gray-600">Response Time</p>
                <p className="text-lg font-semibold text-gray-900 mt-1">{selectedAgent.responseTime}ms</p>
              </div>
              <div>
                <p className="text-sm font-medium text-gray-600">Tasks Completed</p>
                <p className="text-lg font-semibold text-gray-900 mt-1">{selectedAgent.tasksCompleted.toLocaleString()}</p>
              </div>
              <div>
                <p className="text-sm font-medium text-gray-600">Category</p>
                <p className="text-lg font-semibold text-gray-900 mt-1">{selectedAgent.category}</p>
              </div>
              <div>
                <p className="text-sm font-medium text-gray-600">Last Update</p>
                <p className="text-lg font-semibold text-gray-900 mt-1">{selectedAgent.lastUpdate}</p>
              </div>
              <div>
                <p className="text-sm font-medium text-gray-600">Agent ID</p>
                <p className="text-lg font-semibold text-gray-900 mt-1 font-mono">{selectedAgent.id}</p>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Results Summary */}
      <div className="mt-6 text-center text-gray-500 text-sm">
        Showing {filteredAgents.length} of {systemStats.totalAgents} agents
        {searchTerm && ` matching "${searchTerm}"`}
        {filterStatus !== 'all' && ` with status "${filterStatus}"`}
      </div>
    </div>
  );

  const renderPlaceholderContent = (title: string, description: string) => (
    <div className="bg-white rounded-lg shadow-sm border p-8 text-center">
      <h2 className="text-2xl font-semibold text-gray-900 mb-4">{title}</h2>
      <p className="text-gray-600 mb-6">{description}</p>
      <div className="text-4xl text-gray-300 mb-4">🚧</div>
      <p className="text-sm text-gray-500">This section is under development and will be available soon.</p>
    </div>
  );

  const renderContent = () => {
    switch (activeNavItem) {
      case 'overview':
        return renderSystemOverview();
      case 'agents':
        return renderAgentManagement();
      case 'workflows':
        return renderPlaceholderContent(
          'Workflow Engine',
          'Design and manage complex multi-agent workflows for agricultural processes.'
        );
      case 'monitoring':
        return renderPlaceholderContent(
          'Real-time Monitoring',
          'Monitor agent performance, system health, and live agricultural data feeds.'
        );
      case 'documentation':
        return renderPlaceholderContent(
          'System Documentation',
          'Comprehensive guides, API documentation, and best practices for AgentWeaver.'
        );
      case 'settings':
        return renderPlaceholderContent(
          'System Settings',
          'Configure system parameters, agent settings, and integration options.'
        );
      default:
        return renderSystemOverview();
    }
  };

  return (
    <div className="min-h-screen bg-gray-50 flex">
      {/* Sidebar */}
      <div className={`bg-white border-r border-gray-200 transition-all duration-300 ${
        sidebarOpen ? 'w-64' : 'w-16'
      }`}>
        <div className="p-4 border-b border-gray-200">
          <div className="flex items-center gap-3">
            <div className="w-8 h-8 bg-green-600 rounded-lg flex items-center justify-center">
              <Sun className="w-5 h-5 text-white" />
            </div>
            {sidebarOpen && (
              <div>
                <h1 className="font-bold text-gray-900">AgentWeaver</h1>
                <p className="text-xs text-gray-600">Agriculture System</p>
              </div>
            )}
          </div>
        </div>
        
        <nav className="p-4">
          <ul className="space-y-2">
            {navigationItems.map((item) => (
              <li key={item.id}>
                <button
                  onClick={() => setActiveNavItem(item.id)}
                  className={`w-full flex items-center gap-3 px-3 py-2 rounded-lg transition-colors ${
                    activeNavItem === item.id
                      ? 'bg-green-50 text-green-700 border border-green-200'
                      : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'
                  }`}
                  title={!sidebarOpen ? item.name : undefined}
                >
                  {item.icon}
                  {sidebarOpen && <span className="font-medium">{item.name}</span>}
                </button>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      {/* Main Content */}
      <div className="flex-1 flex flex-col">
        {/* Header */}
        <div className="bg-white border-b border-gray-200 px-6 py-4">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-4">
              <button
                onClick={() => setSidebarOpen(!sidebarOpen)}
                className="p-2 hover:bg-gray-100 rounded-lg transition-colors"
              >
                {sidebarOpen ? <X className="w-5 h-5" /> : <Menu className="w-5 h-5" />}
              </button>
              <div>
                <h1 className="text-2xl font-bold text-gray-900">
                  {navigationItems.find(item => item.id === activeNavItem)?.name || 'System Overview'}
                </h1>
                <p className="text-sm text-gray-600 mt-1">Professional Multi-Agent Orchestration Platform</p>
              </div>
            </div>
            <div className="flex items-center gap-4">
              <div className="text-xs text-gray-500">
                Last updated: {lastUpdated.toLocaleTimeString()}
              </div>
              <button
                onClick={handleRefresh}
                className={`flex items-center gap-2 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors ${
                  refreshing ? 'opacity-75' : ''
                }`}
                disabled={refreshing}
              >
                <RefreshCw className={`w-4 h-4 ${refreshing ? 'animate-spin' : ''}`} />
                Refresh
              </button>
            </div>
          </div>
        </div>

        {/* Content */}
        <div className="flex-1 p-6">
          {renderContent()}
        </div>
      </div>
    </div>
  );
};

export default MultiAgentAgricultureDashboard;
